# AI Stats backend configuration. Copy to backend/.env and fill in.

# PostgreSQL connection string. Migrations run automatically on startup.
DATABASE_URL=postgres://aistats:aistats@localhost:5432/aistats?sslmode=disable

# Generate each with: openssl rand -hex 32
# (ENCRYPTION_KEY must be exactly 64 hex characters.)
JWT_SECRET=
ENCRYPTION_KEY=

# GitHub OAuth App (callback URL: <APP_URL>/api/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL the frontend is served from (post-login redirect and CORS origin).
APP_URL=http://localhost:3000

# HTTP port for the API server (default 8080).
PORT=8080

# How often to sync every connected org from GitHub in the background
# (Copilot usage, Claude Code commit attribution, member count) — the same
# work as the dashboard's "Sync now" button. Go duration, minimum 1m.
# Default 1h. Set to 0 or off to disable and sync only on demand.
SYNC_INTERVAL=1h
