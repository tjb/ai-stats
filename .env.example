# AI Stats configuration for `docker compose up`.
#
#   cp .env.example .env
#
# then fill in the empty values below. .env is git-ignored; never commit it.

# Public URL people use to open AI Stats. It is the OAuth callback base
# (APP_URL/api/auth/callback), the CORS origin and the post-login redirect,
# and an https:// URL turns on Secure cookies. Behind a TLS reverse proxy, set
# it to the public https:// address.
APP_URL=http://localhost:8080

# GitHub OAuth App: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:               http://localhost:8080
#   Authorization callback URL: http://localhost:8080/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secrets. Generate each one separately with:
#   openssl rand -hex 32
# JWT_SECRET signs session cookies; changing it signs everyone out.
JWT_SECRET=
# ENCRYPTION_KEY (exactly 64 hex characters) encrypts stored GitHub tokens with
# AES-256-GCM. Keep it safe: if it is lost, users must reconnect GitHub.
ENCRYPTION_KEY=

# Bundled Postgres (not exposed outside the compose network). docker-compose.yml
# builds the app's DATABASE_URL from these, so use URL-safe characters, e.g.
# `openssl rand -hex 16` for the password. Set them before the first start: they
# only take effect when the db volume is created.
POSTGRES_USER=aistats
POSTGRES_PASSWORD=aistats
POSTGRES_DB=aistats

# How often to re-sync every connected org from GitHub in the background (the
# same work as "Sync now"). Go duration, minimum 1m; 0 or off disables it.
# SYNC_INTERVAL=1h

# Running the server outside Docker instead (`make dev-backend`)? Use
# backend/.env.example, which is set up for the Vite dev server on :3000.
